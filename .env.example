# PostgreSQL local creado para el proyecto.
MARCANO_DATABASE_URL=postgresql+psycopg://admin:admin@127.0.0.1:5433/marcano
# Alternativa para pruebas sin servidor:
# MARCANO_DATABASE_URL=sqlite:///./data/marcano.db
MARCANO_APP_NAME=Marcano Inventario
MARCANO_DEFAULT_CURRENCY=USD
MARCANO_LOCALE=es_ES
# Sustituir por una clave aleatoria y privada fuera de desarrollo.
MARCANO_JWT_SECRET_KEY=cambia-esta-clave-por-una-clave-aleatoria-y-privada
MARCANO_JWT_ALGORITHM=HS256
MARCANO_JWT_EXPIRATION_MINUTES=480
